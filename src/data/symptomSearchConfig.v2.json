{
  "meta": {
    "name": "Dynamis RM03 - configuration recherche homéopathique v2",
    "version": "2.0.0",
    "purpose": "Améliorer la précision et la facilité de recherche en langage courant sans modifier les codes RM03.",
    "homeopathy_only": true,
    "web_enrichment_scope": "Structure de répertoire, vocabulaire et hiérarchie. Les correspondances remède-problème restent issues prioritairement des livres de l'utilisateur.",
    "web_sources": [
      {
        "title": "Kent's Repertory",
        "url": "https://www.homeoint.org/hidb/kent/repertory.htm",
        "use": "hiérarchie des rubriques : tête, yeux, vision, oreilles, audition, nez, gorge, estomac, etc."
      },
      {
        "title": "Boericke Repertory",
        "url": "https://www.homeoint.org/books4/boerirep/",
        "use": "sous-rubriques anatomiques et symptomatiques, notamment yeux/oreilles."
      },
      {
        "title": "NCCIH - Homeopathy",
        "url": "https://www.nccih.nih.gov/health/homeopathy",
        "use": "notice de sécurité et distinction entre répertoire traditionnel et efficacité clinique démontrée."
      }
    ]
  },
  "ui": {
    "home_title": "Dynamis RM03",
    "home_subtitle": "Codes et répertoire homéopathique RM03",
    "home_search_card_title": "Rechercher un remède homéopathique",
    "home_search_card_subtitle": "À partir de symptômes ou d’un problème de santé",
    "screen_title": "Recherche homéopathique par symptômes",
    "placeholder": "Ex. : oreille qui siffle, yeux rouges, toux sèche…",
    "badge": "Répertoire homéopathique",
    "notice_short": "Correspondances issues d’ouvrages et répertoires homéopathiques. Ne constitue pas un diagnostic médical.",
    "notice_evidence": "L’efficacité de l’homéopathie n’est pas établie pour une affection spécifique ; ne pas retarder des soins médicaux nécessaires."
  },
  "search_rules": {
    "important_change": "Classer d’abord la condition/problème, puis classer les remèdes à l’intérieur de cette condition. Ne jamais afficher tous les remèdes d’une rubrique large comme s’ils étaient également pertinents.",
    "single_body_part_query": "Si la requête ne contient qu’une zone anatomique (ex. oreille, yeux), afficher d’abord les propositions de précision, pas une longue liste de remèdes.",
    "do_not_search_in": [
      "noms de remèdes pour trouver une condition",
      "posologies",
      "phrases de traitement",
      "search_text brut non filtré"
    ],
    "fields_and_weights": {
      "label_exact": 140,
      "label_phrase": 100,
      "lay_alias_exact": 95,
      "alias": 85,
      "keywords_v2": 60,
      "symptom_phrase": 45,
      "symptom_token": 18,
      "raw_source_context": 2
    },
    "minimum_coverage_multiword": 0.6,
    "max_condition_results": 8,
    "max_remedies_initially": 5,
    "require_word_boundaries": true,
    "broad_condition_penalty": 0.45,
    "multi_source_remedy_bonus": 15
  },

{
  "expo": {
    "name": "Dynamis RM03",
    "slug": "dynamis-rm03",
    "version": "1.0.0",
    "scheme": "dynamis-rm03",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#F8F2E6"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.svmdotcom.dynamisrm03",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#F8F2E6"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-localization"
    ],
    "extra": {
      "eas": {
        "projectId": "d4557b77-5a4b-4e77-b982-313851c155cb"
      }
    }
  }
}